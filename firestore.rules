rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Hardcoded admin for the requester
      return isSignedIn() && 
             request.auth.token.email == 'sabotmate0813@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPortfolioItem(data) {
      return data.keys().hasAll(['id', 'category', 'title', 'images']) &&
             data.id is string && data.id.size() <= 128 &&
             data.category is string && data.category.size() <= 64 &&
             data.title is string && data.title.size() <= 512 &&
             // Optional fields with existence checks
             (!('application' in data) || (data.application is string && data.application.size() <= 128)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 10000)) &&
             (!('client' in data) || (data.client is string && data.client.size() <= 512)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 512)) &&
             (!('process' in data) || (data.process is list)) &&
             (!('updatedAt' in data) || (data.updatedAt is string)) &&
             data.images is list && data.images.size() <= 50;
    }

    match /portfolio/{itemId} {
      allow get: if true;
      allow list: if true;
      
      allow create: if isAdmin() && 
                      isValidId(itemId) && 
                      isValidPortfolioItem(incoming()) &&
                      incoming().id == itemId;
                      
      allow update: if isAdmin() && 
                      isValidId(itemId) && 
                      isValidPortfolioItem(incoming()) &&
                      // Basic immutability
                      incoming().id == existing().id;
                      
      allow delete: if isAdmin();

      // Subcollection for images
      match /images/{imageId} {
        allow read: if true;
        allow write: if isAdmin() && isValidId(imageId);
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(categoryId);

      match /subcategories/{subcategoryId} {
        allow read: if true;
        allow write: if isAdmin() && isValidId(subcategoryId);
      }
    }
  }
}
